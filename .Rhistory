library(sf)
library(ggplot2)
library(viridis)
# 1) Konvertierung zu sf (funktioniert definitiv mit deinen Objekten)
study_area_sf <- st_as_sf(study_area)
soil_sf <- st_as_sf(soil_csv)
# 2) Karte: Study Area + Punkte mit Größe nach CEC
ggplot() +
# Study Area als Hintergrund
geom_sf(data = study_area_sf,
fill = "lightblue",
color = "black",
alpha = 0.4) +
# Soil-Punkte mit Größe nach CEC
geom_sf(data = soil_sf,
aes(size = CEC),           # Größe variiert nach CEC-Wert
alpha = 0.8,
color = "darkred") +       # einheitliche Farbe
scale_size_continuous(name = "CEC-Wert",
range = c(1, 8),     # Min/Max Punktgröße
breaks = pretty(soil_csv$CEC)) +
# Automatische Ausdehnung auf Study Area
coord_sf(expand = FALSE) +
labs(title = "CEC-Werte im Untersuchungsgebiet",
size = "CEC") +
theme_minimal() +
theme(legend.position = "right")
ggplot() +
geom_sf(data = study_area_sf,
fill = "darkgreen",
color = "black",
alpha = 0.4) +
geom_sf(data = soil_sf,
aes(size = CEC),
alpha = 0.8,
color = "darkred") +
scale_size_continuous(name = "CEC-Wert",
range = c(1, 8),
breaks = pretty(soil_csv$CEC)) +
coord_sf(expand = FALSE) +
labs(title = "CEC-Werte im Untersuchungsgebiet",
size = "CEC") +
theme_minimal() +
theme(legend.position = "right")
ggplot() +
geom_sf(data = study_area_sf,
fill = "darkgreen",
color = "black",
alpha = 0.4) +
geom_sf(data = soil_sf,
aes(size = CEC),
alpha = 0.8,
color = "grey") +
scale_size_continuous(name = "CEC-Wert",
range = c(1, 8),
breaks = pretty(soil_csv$CEC)) +
coord_sf(expand = FALSE) +
labs(title = "CEC-Werte im Untersuchungsgebiet",
size = "CEC") +
theme_minimal() +
theme(legend.position = "right")
