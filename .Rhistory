library(classInt)  # Für natural breaks
# 1) Natural breaks berechnen
breaks <- classIntervals(soil_csv$CEC, n = 5, style = "jenks")$brks
print(breaks)  # Zeigt die Breakpoints
# 2) Dein Code mit natural breaks Legende
study_area_sf <- st_as_sf(study_area)
soil_sf <- st_as_sf(soil_csv)
ggplot() +
geom_sf(data = study_area_sf,
fill = "grey",
color = "black",
alpha = 0.4) +
geom_sf(data = soil_sf,
aes(size = CEC),
shape = 21,
fill = "darkgreen",
color = "black",
stroke = 1,
alpha = 0.8) +
scale_size_continuous(name = "CEC-Wert",
range = c(1, 8),
breaks = breaks,              # ← Natural breaks!
labels = round(breaks, 1)) +  # ← Gerundete Labels
coord_sf(expand = FALSE) +
labs(title = "Cation Exchange Capacity (CEC) in Study Area",
size = "CEC") +
theme_minimal() +
theme(legend.position = "right")
